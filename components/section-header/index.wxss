.sh {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 16rpx;
}

.sh-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.sh-bar {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--warning);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.sh-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  flex-shrink: 0;
}

.sh-sub {
  font-size: 24rpx;
  color: var(--primary);
  margin-left: 14rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sh-extra {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-3);
  flex-shrink: 0;
  padding-left: 20rpx;
}

.sh-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 2rpx solid var(--text-4);
  border-right: 2rpx solid var(--text-4);
  transform: rotate(45deg);
  margin-left: 8rpx;
}
