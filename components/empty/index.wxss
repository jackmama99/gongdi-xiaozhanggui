.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx 40rpx;
}

.empty-icon {
  font-size: 64rpx;
  opacity: 0.3;
  margin-bottom: 24rpx;
  line-height: 1;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-4);
  text-align: center;
}

.empty-action {
  margin-top: 28rpx;
  padding: 14rpx 44rpx;
  border-radius: 28rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 26rpx;
}
