<view wx:if="{{visible}}" class="popup-mask" bindtap="onMask" catchtouchmove="noop">
  <view class="popup-panel" style="max-height:{{maxHeight}}" catchtap="noop">
    <view class="popup-head">
      <text class="popup-cancel" bindtap="onCancel">{{cancelText}}</text>
      <text class="popup-title">{{title}}</text>
      <text class="popup-confirm" bindtap="onConfirm">{{confirmText}}</text>
    </view>
    <scroll-view scroll-y class="popup-body">
      <slot></slot>
    </scroll-view>
  </view>
</view>
