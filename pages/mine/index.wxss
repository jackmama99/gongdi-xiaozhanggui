.user-header {
  position: relative;
  padding: 40rpx 28rpx 100rpx;
  overflow: hidden;
}

.user-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 340rpx;
  background: var(--primary);
  border-radius: 0 0 44rpx 44rpx;
}

.user-main {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.24);
  border: 3rpx solid rgba(255, 255, 255, 0.55);
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.user-role {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.role-badge {
  font-size: 20rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.24);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.dept {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-phone {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 10rpx;
}

.setting-btn {
  font-size: 36rpx;
  flex-shrink: 0;
  padding: 10rpx;
}

/* 统计 */
.stat-row {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 0;
  margin-top: -64rpx;
  box-shadow: 0 8rpx 28rpx rgba(27, 34, 51, 0.08);
  position: relative;
  z-index: 2;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item + .stat-item {
  border-left: 1rpx solid var(--line);
}

.stat-num {
  font-size: 40rpx;
  color: var(--primary);
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

/* 公司卡 */
.company-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-top: 24rpx;
  gap: 20rpx;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--line);
}

.company-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.company-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.company-addr {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

/* 菜单 */
.menu-group {
  margin-top: 32rpx;
}

.menu-group-title {
  font-size: 24rpx;
  color: var(--text-3);
  padding-left: 8rpx;
  margin-bottom: 16rpx;
}

.menu-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--line);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-hover {
  background: var(--fill);
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}

.menu-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}

/* 退出 */
.logout-btn {
  margin-top: 40rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: var(--danger);
  box-shadow: var(--shadow);
}

.version {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 32rpx;
}

.bottom-space {
  height: 40rpx;
}
