/* ---------------- 分段按钮 ---------------- */
.seg {
  min-width: 96rpx;
  min-height: 56rpx;
  line-height: 1.3;
  padding: 8rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 28rpx;
  background: var(--bg);
  color: var(--text-2);
  font-size: 26rpx;
  margin-left: 14rpx;
}

.seg.active {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 500;
}

/* ---------------- 等级选择 ---------------- */
.form-item-block {
  flex-direction: column;
  align-items: stretch;
  padding: 24rpx 0;
}

.form-item-block .form-label {
  width: auto;
  margin-bottom: 18rpx;
}

.level-row {
  display: flex;
  gap: 16rpx;
}

.level-btn {
  flex: 1;
  height: 100rpx;
  border-radius: 16rpx;
  background: var(--fill);
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.level-letter {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-2);
  line-height: 1.2;
}

.level-tip {
  font-size: 20rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

.level-btn.active {
  border-color: currentColor;
}

.level-A {
  color: var(--danger);
}
.level-B {
  color: var(--warning);
}
.level-C {
  color: var(--primary);
}
.level-D {
  color: var(--text-3);
}

.level-btn.active .level-letter {
  color: inherit;
}

.level-btn.active.level-A {
  background: var(--danger-light);
}

.level-btn.active.level-B {
  background: var(--warning-light);
}

.level-btn.active.level-C {
  background: var(--primary-light);
}

.level-btn.active.level-D {
  background: var(--fill);
}

/* ---------------- 文本域 ---------------- */
.textarea {
  width: 100%;
  min-height: 160rpx;
  background: var(--fill);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-sizing: border-box;
}

/* ---------------- 日期 ---------------- */
.date-btn {
  margin-left: 16rpx;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 24rpx;
  flex-shrink: 0;
}

.link-clear {
  font-size: 24rpx;
  color: var(--text-4);
}


.form-value-readonly {
  color: var(--text-3);
}
