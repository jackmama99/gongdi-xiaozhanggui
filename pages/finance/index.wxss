/* 财务中心 */
.page {
  padding-bottom: 60rpx;
}

/* ---------------- 顶部深色渐变卡片 ---------------- */
.hero-wrap {
  padding: 24rpx 24rpx 0;
}

.hero {
  border-radius: 28rpx;
  padding: 32rpx;
  background: var(--primary);
  box-shadow: 0 12rpx 32rpx rgba(35, 52, 92, 0.28);
  position: relative;
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  right: -80rpx;
  top: -100rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
}

.hero-head {
  position: relative;
  z-index: 1;
}

.hero-emoji {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.hero-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.86);
  font-weight: 500;
}

.hero-month {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.hero-main {
  margin-top: 28rpx;
  position: relative;
  z-index: 1;
}

.hero-main-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.hero-main-value {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.hero-sign {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
  margin-right: 4rpx;
}

.hero-num {
  font-size: 64rpx;
  color: #fff;
  line-height: 1.1;
}

.hero-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 8rpx;
}

.hero-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  position: relative;
  z-index: 1;
}

.hero-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hero-item-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #6fc7a4;
  margin-bottom: 10rpx;
}

.hero-item-dot-warn {
  background: #ffc078;
}

.hero-item-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.hero-item-value {
  font-size: 32rpx;
  color: #fff;
  margin-top: 6rpx;
}

.hero-split {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.14);
  margin: 0 24rpx;
}

/* ---------------- 核心指标四宫格 ---------------- */
.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.metric-item {
  width: calc((100% - 20rpx) / 2);
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow);
}

.metric-emoji {
  font-size: 26rpx;
}

.metric-label {
  font-size: 24rpx;
  color: var(--text-3);
}

.metric-value {
  font-size: 40rpx;
  color: var(--text-1);
  margin-top: 10rpx;
  line-height: 1.2;
}

.metric-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

/* ---------------- 资金台账入口 ---------------- */
.entry-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.entry {
  width: calc((100% - 20rpx) / 2);
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow);
}

.entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.entry-icon-blue {
  background: var(--primary-light);
}

.entry-icon-orange {
  background: var(--warning-light);
}

.entry-icon-violet {
  background: var(--violet-light);
}

.entry-icon-green {
  background: var(--success-light);
}

.entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.entry-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

/* ---------------- 通用列表卡片 ---------------- */
.list-card {
  padding: 0 28rpx;
}

.row-hover {
  background: var(--bg);
}

.recv-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.recv-item.last,
.recent-item.last {
  border-bottom: none;
}

.recv-left {
  flex: 1;
  min-width: 0;
}

.recv-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.recv-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

.recv-right {
  text-align: right;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.recv-amount {
  font-size: 30rpx;
  color: var(--text-1);
}

.recv-due {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.recv-tip {
  font-size: 20rpx;
  margin-top: 2rpx;
}

/* ---------------- 待审批支出 ---------------- */
.exp-wrap {
  border-bottom: 1rpx solid var(--line);
}

.exp-wrap.last {
  border-bottom: none;
}

.exp-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}

.exp-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: var(--warning-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.exp-right {
  text-align: right;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.exp-actions {
  padding: 0 0 26rpx;
}

.exp-hint {
  font-size: 20rpx;
  color: var(--text-4);
}

/* ---------------- 最近收款 ---------------- */
.recent-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.recent-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 28rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.recent-name {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}

.recent-right {
  text-align: right;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.foot-hint {
  text-align: center;
  font-size: 20rpx;
  color: var(--text-4);
  padding: 40rpx 0 20rpx;
}
