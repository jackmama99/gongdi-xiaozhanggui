/* 收款登记 */

/* 合同信息卡 */
.ct-card {
  background: var(--primary);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 110, 246, 0.26);
}

.ct-emoji {
  font-size: 30rpx;
}

.ct-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  max-width: 320rpx;
}

.ct-no {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.ct-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  gap: 16rpx;
}

.ct-project {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  flex: 1;
  min-width: 0;
}

.ct-phone {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  flex-shrink: 0;
}

.ct-amounts {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}

.ct-amount-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ct-amount-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
}

.ct-amount-value {
  font-size: 30rpx;
  color: #fff;
  margin-top: 6rpx;
}

.ct-percent {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  flex-shrink: 0;
}

/* 表单卡片 */
.form-card {
  padding: 28rpx;
}

/* 期次详情 */
.plan-box {
  background: var(--bg);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 22rpx;
  margin: 16rpx 0 4rpx;
}

.plan-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.plan-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

/* 金额输入 */
.amount-prefix {
  font-size: 30rpx;
  color: var(--text-2);
  font-weight: 600;
  margin-right: 6rpx;
}

.amount-input {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
}

.fill-all {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 提示 */
.tips {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--warning-light);
  border-radius: 16rpx;
}

.tips-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.tips-text {
  font-size: 22rpx;
  color: var(--warning);
  line-height: 1.6;
  flex: 1;
}
