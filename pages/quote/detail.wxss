/* ---------------- 头部 ---------------- */
.head {
  background: var(--primary);
  padding: 28rpx 28rpx 32rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.head-no {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 0.5rpx;
}

.head-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.4;
  margin-top: 14rpx;
}

.head-row {
  margin-top: 16rpx;
}

.head-chip {
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.head-meta {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

/* ---------------- 金额卡 ---------------- */
.amount-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx 24rpx;
  margin-top: 24rpx;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--line);
}

.ac-label {
  font-size: 24rpx;
  color: var(--text-3);
}

.ac-total {
  align-items: baseline;
  margin-top: 10rpx;
}

.ac-yen {
  font-size: 30rpx;
  color: var(--primary);
  font-weight: 600;
  margin-right: 8rpx;
}

.ac-num {
  font-size: 60rpx;
  color: var(--primary);
  line-height: 1.1;
}

.ac-wan {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.ac-lines {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--line);
}

.ac-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.ac-line-k {
  font-size: 26rpx;
  color: var(--text-2);
}

.ac-line-v {
  font-size: 26rpx;
  color: var(--text-1);
}

/* ---------------- 单价分析 ---------------- */
.unit-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.unit-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.unit-label {
  font-size: 22rpx;
  color: var(--text-3);
}

.unit-value {
  font-size: 32rpx;
  color: var(--text-1);
  margin-top: 6rpx;
}

.unit-unit {
  font-size: 20rpx;
  color: var(--text-3);
  font-weight: 400;
}

.unit-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--line);
  margin: 0 24rpx;
}

/* ---------------- 明细分组 ---------------- */
.group {
  padding: 0;
  overflow: hidden;
}

.group-head {
  background: var(--fill);
  padding: 20rpx 24rpx;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.group-count {
  font-size: 20rpx;
  color: var(--text-3);
  margin-left: 12rpx;
}

.group-sub {
  font-size: 26rpx;
  color: var(--primary);
}

.item-head {
  padding: 14rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.item-head text {
  font-size: 20rpx;
  color: var(--text-4);
}

.item-row {
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--fill);
  align-items: flex-start;
}

.item-row:last-child {
  border-bottom: none;
}

.col-name {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 26rpx;
  color: var(--text-1);
  line-height: 1.4;
}

.item-spec {
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.col-qty {
  width: 100rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-2);
  flex-shrink: 0;
}

.item-head .col-qty {
  font-size: 20rpx;
  color: var(--text-4);
}

.col-price {
  width: 110rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-2);
  flex-shrink: 0;
}

.col-amount {
  width: 130rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-1);
  flex-shrink: 0;
}
