/* ---------------- 表单扩展 ---------------- */
.form-item-col {
  flex-direction: column;
  align-items: stretch;
  padding: 20rpx 0;
}

.form-item-col .form-label {
  width: auto;
  margin-bottom: 12rpx;
}

.input-block {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: var(--fill);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-sizing: border-box;
}

/* ---------------- 明细卡片 ---------------- */
.item-card {
  padding: 20rpx 28rpx 8rpx;
}

.item-title {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 4rpx;
}

.item-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.item-cat {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}

.mini-btn {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  margin-left: 12rpx;
}

.mini-btn.danger {
  color: var(--danger);
  background: var(--danger-light);
}

.item-amount {
  padding: 18rpx 0 20rpx;
  margin-top: 8rpx;
  border-top: 1rpx dashed var(--line);
}

.ia-label {
  font-size: 22rpx;
  color: var(--text-3);
}

.ia-value {
  font-size: 30rpx;
  color: var(--primary);
}

.add-item {
  margin-top: 20rpx;
  height: 88rpx;
  border-radius: 20rpx;
  border: 2rpx dashed var(--primary-light);
  background: var(--fill);
  color: var(--primary);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-item:active {
  opacity: 0.7;
}

/* ---------------- 底部实时汇总 ---------------- */
.bottom-placeholder-summary {
  height: 330rpx;
}

.summary-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 24rpx rgba(27, 34, 51, 0.1);
  z-index: 40;
  border: 1rpx solid var(--line);
}

.sum-lines {
  display: flex;
  flex-wrap: wrap;
  border-bottom: 1rpx dashed var(--line);
  padding-bottom: 12rpx;
}

.sum-line {
  width: 50%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 12rpx 4rpx 0;
  box-sizing: border-box;
}

.sl-k {
  font-size: 22rpx;
  color: var(--text-3);
}

.sl-v {
  font-size: 24rpx;
  color: var(--text-1);
}

.sum-total {
  padding-top: 16rpx;
}

.st-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-right: 10rpx;
}

.st-yen {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  margin-right: 4rpx;
}

.st-num {
  font-size: 40rpx;
  color: var(--primary);
}
