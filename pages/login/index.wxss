.login-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
  display: flex;
  flex-direction: column;
}

/* 顶部品牌区：整块蓝色，底部圆角，不再硬切斜边 */
.hero {
  background: var(--primary);
  border-radius: 0 0 48rpx 48rpx;
  padding: 100rpx 48rpx 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  color: #fff;
  font-size: 54rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
}

.brand-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.brand-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

/* 登录卡片：上移压住蓝色区，形成层次 */
.login-card {
  margin: -96rpx 48rpx 0;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 40rpx 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(27, 34, 51, 0.1);
  border: 1rpx solid var(--line);
}

/* 微信一键登录 */
.wechat-btn {
  min-height: 92rpx;
  line-height: 1.35;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.wechat-btn::after {
  border: none;
}

.wechat-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}

.btn-dim {
  opacity: 0.6;
}

/* 分隔线 */
.divider {
  display: flex;
  align-items: center;
  margin: 32rpx 0 28rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: var(--line);
}

.divider-text {
  padding: 0 20rpx;
  font-size: 22rpx;
  color: var(--text-4);
}

/* 输入框 */
.input-box {
  display: flex;
  align-items: center;
  height: 96rpx;
  background: var(--bg);
  border-radius: 20rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.input-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-1);
  height: 96rpx;
}

.input-ph {
  color: var(--text-4);
  font-size: 28rpx;
}

.pwd-eye {
  font-size: 28rpx;
  padding-left: 16rpx;
  opacity: 0.7;
}

.login-error {
  font-size: 24rpx;
  color: var(--danger);
  background: var(--danger-light);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 20rpx;
}

/* 账号登录按钮 */
.btn-login {
  margin-top: 12rpx;
  min-height: 92rpx;
  line-height: 1.35;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  color: #fff;
  background: var(--primary);
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(59, 110, 246, 0.28);
}

.btn-login::after {
  border: none;
}

.demo-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--primary);
  margin-top: 28rpx;
}

/* 没有账号入口：标题 + 两行说明，不再占一张大卡 */
.links {
  margin-top: 32rpx;
  padding: 0 24rpx;
  text-align: center;
}

.links-main {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
}

.links-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-3);
}

/* 演示账号 */
.account-panel {
  margin: 32rpx 48rpx 0;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  border: 1rpx solid var(--line);
}

.account-title {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 20rpx;
  text-align: center;
}

.account-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.account-item {
  width: calc(50% - 8rpx);
  display: flex;
  align-items: center;
  background: var(--fill);
  border-radius: 20rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
}

.account-item:active {
  background: var(--primary-light);
}

.account-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.account-info {
  flex: 1;
  min-width: 0;
}

.account-name {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 500;
}

.account-role {
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 2rpx;
}

.account-code {
  font-size: 20rpx;
  color: var(--text-4);
  font-family: monospace;
}

.login-footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 48rpx;
}

/* 协议同意 */
.agree-row {
  display: flex;
  align-items: flex-start;
  margin-top: 28rpx;
  padding: 0 4rpx;
}

.agree-box {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--text-4);
  margin-right: 14rpx;
  margin-top: 3rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.agree-box-on {
  background: var(--primary);
  border-color: var(--primary);
}

.agree-check {
  color: #fff;
  font-size: 22rpx;
  line-height: 1;
}

.agree-text {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--text-3);
}

.agree-link {
  color: var(--primary);
}

.agree-shake {
  animation: agreeShake 0.4s ease;
}

@keyframes agreeShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}
