.team-hero {
  display: flex;
  align-items: center;
  background: var(--primary);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

.team-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.team-main {
  flex: 1;
  min-width: 0;
}

.team-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.team-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.team-edit {
  font-size: 24rpx;
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}

.stat-row {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
}

.stat-cell {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-cell + .stat-cell::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 1rpx;
  background: var(--line);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.invite-card {
  text-align: center;
}

.invite-code {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 14rpx;
  color: var(--primary);
  margin: 12rpx 0 10rpx;
}

.invite-hint {
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.7;
  padding: 0 12rpx;
}

.invite-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.invite-btn {
  flex: 1;
  font-size: 26rpx;
  min-height: 76rpx;
  line-height: 1.3;
  padding: 12rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.invite-ghost {
  background: var(--bg);
  color: var(--primary);
}

.invite-reset {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 22rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}

.member-me {
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 8rpx;
}

.member-phone {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.role-pill {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
}

.role-pill-static {
  color: var(--text-3);
  background: var(--bg);
}

.role-owner {
  color: var(--warning);
  background: var(--warning-light);
}

.member-del {
  font-size: 24rpx;
  color: var(--danger);
  padding: 8rpx 0 8rpx 24rpx;
}

.tip-bar {
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.7;
  padding: 8rpx 8rpx 40rpx;
}

.rename-box {
  padding: 8rpx 0 20rpx;
}

.rename-input {
  height: 92rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.form-ph {
  color: var(--text-4);
}
