/* ---------------- 顶部 ---------------- */
.head {
  background: var(--primary);
  padding: 28rpx 28rpx 28rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.head-no {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 0.5rpx;
}

.head-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.4;
  margin-top: 14rpx;
}

.head-amount-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  margin-top: 26rpx;
}

.head-amount {
  align-items: baseline;
  margin-top: 4rpx;
}

.ha-yen {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
  margin-right: 6rpx;
}

.ha-num {
  font-size: 62rpx;
  color: #fff;
  line-height: 1.1;
}

.ha-wan {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.head-grid {
  display: flex;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx 0;
}

.hg-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid rgba(255, 255, 255, 0.18);
}

.hg-item:last-child {
  border-right: none;
}

.hg-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hg-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 6rpx;
}

/* ---------------- 收款进度 ---------------- */
.progress-card {
  margin-top: 24rpx;
}

.pc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.pc-rate {
  font-size: 32rpx;
  color: var(--primary);
}

.pc-numbers {
  display: flex;
  margin-top: 22rpx;
}

.pc-num-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.pn-label {
  font-size: 22rpx;
  color: var(--text-3);
}

.pn-value {
  font-size: 26rpx;
  color: var(--text-1);
  margin-top: 6rpx;
}

.overdue-banner {
  margin-top: 20rpx;
  background: var(--danger-light);
  color: var(--danger);
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
}

/* ---------------- 键值 ---------------- */
.kv {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.kv:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.kv:first-child {
  padding-top: 0;
}

.kv-k {
  width: 170rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-3);
}

.kv-v {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-1);
  text-align: right;
  word-break: break-all;
}

.kv-block {
  flex-direction: column;
}

.kv-block .kv-k {
  width: auto;
}

.kv-multi {
  text-align: left;
  margin-top: 10rpx;
  color: var(--text-2);
  line-height: 1.65;
  background: var(--fill);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

/* ---------------- 收款计划 ---------------- */
.plan {
  padding: 24rpx 28rpx;
}

.plan-overdue {
  border-left: 6rpx solid var(--danger);
}

.plan-seq {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.plan-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.plan-main {
  margin-top: 18rpx;
  align-items: flex-end;
}

.plan-amount-label {
  font-size: 22rpx;
  color: var(--text-3);
}

.plan-amount {
  font-size: 36rpx;
  color: var(--text-1);
  margin-top: 4rpx;
  line-height: 1.2;
}

.plan-due {
  align-items: flex-end;
}

.plan-due-label {
  font-size: 22rpx;
  color: var(--text-3);
}

.plan-due-value {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}

.plan-foot {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--line);
}

.pf-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-right: 8rpx;
}

.pf-paid {
  font-size: 24rpx;
  color: var(--success);
}

.pf-date {
  font-size: 22rpx;
  color: var(--text-4);
  margin-left: 8rpx;
}

.overdue-tip {
  font-size: 22rpx;
  color: var(--danger);
  font-weight: 500;
}

.settled-tip {
  font-size: 22rpx;
  color: var(--success);
}

.pf-remain {
  font-size: 22rpx;
  color: var(--text-3);
}

/* ---------------- 关联信息 ---------------- */
.cell-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.cell-row:last-child {
  border-bottom: none;
}

.cell-row-hover {
  background: var(--bg);
}

.cell-ico {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.cell-ico.blue {
  background: var(--primary-light);
}

.cell-ico.orange {
  background: var(--warning-light);
}

.cell-ico.violet {
  background: var(--violet-light);
}

.cell-t {
  display: block;
  font-size: 28rpx;
  color: var(--text-1);
}

.cell-s {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.cell-phone {
  font-size: 22rpx;
  color: var(--primary);
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* ---------------- 底部栏 ---------------- */
.bottom-bar .btn {
  padding: 0 22rpx;
  font-size: 28rpx;
}
