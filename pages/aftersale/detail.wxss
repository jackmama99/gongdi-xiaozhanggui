/* ---------------- 顶部工单头卡 ---------------- */
.head {
  background: var(--primary);
  padding: 32rpx 28rpx 26rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.head-no {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  letter-spacing: 1rpx;
}

.head-type {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 16rpx;
}

.head-meta {
  margin-top: 16rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.head-chip {
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
}

.head-grid {
  display: flex;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 16rpx;
  margin-top: 24rpx;
  padding: 18rpx 0;
}

.hg-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid rgba(255, 255, 255, 0.2);
}

.hg-item:last-child {
  border-right: none;
}

.hg-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hg-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 6rpx;
}

/* ---------------- 键值信息 ---------------- */
.kv {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.kv:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.kv:first-child {
  padding-top: 0;
}

.kv-k {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-3);
}

.kv-v {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-1);
  text-align: right;
  word-break: break-all;
}

.kv-block {
  flex-direction: column;
}

.kv-block .kv-k {
  width: auto;
}

.kv-multi {
  text-align: left;
  margin-top: 10rpx;
  color: var(--text-2);
  line-height: 1.65;
  background: var(--fill);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

/* ---------------- 问题描述 ---------------- */
.desc-box {
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 1.7;
  background: var(--fill);
  border-left: 6rpx solid var(--primary);
  border-radius: 0 12rpx 12rpx 0;
  padding: 20rpx 22rpx;
}

.desc-foot {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

/* ---------------- 处理时间轴 ---------------- */
.tl-item {
  display: flex;
  position: relative;
}

.tl-axis {
  width: 40rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--line);
  flex-shrink: 0;
}

.tl-dot.active {
  background: var(--primary);
  box-shadow: 0 0 0 6rpx var(--primary-light);
}

.tl-line {
  flex: 1;
  width: 2rpx;
  background: var(--line);
  margin: 8rpx 0;
  min-height: 40rpx;
}

.tl-body {
  flex: 1;
  min-width: 0;
  padding: 0 0 30rpx 16rpx;
}

.tl-item:last-child .tl-body {
  padding-bottom: 0;
}

.tl-operator {
  font-size: 22rpx;
  color: var(--text-2);
  margin-left: 12rpx;
}

.tl-time {
  font-size: 22rpx;
  color: var(--text-4);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.tl-content {
  display: block;
  font-size: 26rpx;
  color: var(--text-1);
  line-height: 1.6;
  margin-top: 10rpx;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
}

/* ---------------- 弹窗表单 ---------------- */
.popup-form {
  padding: 8rpx 32rpx 20rpx;
}

.pf-block {
  margin-bottom: 30rpx;
}

.pf-block:last-child {
  margin-bottom: 0;
}

.pf-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
}

.pf-textarea {
  width: 100%;
  min-height: 180rpx;
  background: var(--fill);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-sizing: border-box;
}

.pf-ph {
  color: var(--text-4);
  font-size: 28rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 26rpx;
  border-radius: 28rpx;
  background: var(--bg);
  color: var(--text-2);
  font-size: 26rpx;
}

.chip.active {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 500;
}
