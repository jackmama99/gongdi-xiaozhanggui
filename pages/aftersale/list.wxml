<view class="page">
  <!-- 顶部统计 -->
  <view class="head">
    <view class="head-top row-between">
      <view class="col">
        <text class="head-title">售后工单</text>
        <text class="head-sub">{{projectName ? projectName : '全部项目 · 售后服务跟踪'}}</text>
      </view>
      <view class="head-total">
        <text class="head-total-num bold-num">{{stat.total}}</text>
        <text class="head-total-unit">单</text>
      </view>
    </view>

    <view class="head-grid">
      <view class="hg-item">
        <text class="hg-num bold-num t-danger">{{stat.pending}}</text>
        <text class="hg-label">待受理</text>
      </view>
      <view class="hg-item">
        <text class="hg-num bold-num t-warning">{{stat.doing}}</text>
        <text class="hg-label">处理中</text>
      </view>
      <view class="hg-item">
        <text class="hg-num bold-num t-success">{{stat.done}}</text>
        <text class="hg-label">已完成</text>
      </view>
    </view>
  </view>

  <!-- 项目维度筛选提示 -->
  <view wx:if="{{projectId}}" class="scope-bar">
    <text class="scope-text">🏗 仅显示当前项目的工单</text>
    <view class="scope-actions">
      <text class="scope-link" bindtap="goProject">查看项目 ›</text>
      <text class="scope-clear" bindtap="clearProjectFilter">查看全部</text>
    </view>
  </view>

  <!-- 状态筛选 -->
  <view class="tabs-scroll">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-chip {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onFilterTap"
    >
      {{item.key}}<text class="tab-count">{{item.count}}</text>
    </view>
  </view>

  <view class="container list-wrap">
    <view wx:if="{{loading}}" class="loading">加载中…</view>

    <block wx:elif="{{list.length > 0}}">
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="card card-hover ticket"
        data-id="{{item.id}}"
        bindtap="onCardTap"
      >
        <!-- 单号 + 状态 -->
        <view class="row-between">
          <view class="row">
            <text class="t-no">{{item.no}}</text>
            <t-tag class="ml-8" text="{{item.priority}}" type="{{item.priorityColor}}" size="small" dot="{{true}}" />
          </view>
          <t-tag text="{{item.status}}" type="{{item.statusColor}}" size="small" />
        </view>

        <!-- 类型 + 客户/项目 -->
        <view class="row mt-12">
          <text class="t-type">{{item.type}}</text>
          <text class="t-divider">|</text>
          <text class="t-customer">{{item.customerName}}</text>
        </view>
        <view class="row mt-8">
          <text class="t-project ellipsis">🏗 {{item.projectName}}</text>
        </view>

        <!-- 描述摘要 -->
        <view class="t-desc ellipsis-2">{{item.desc}}</view>

        <!-- 最近处理记录 -->
        <view wx:if="{{item.lastRecord}}" class="t-last">
          <text class="t-last-label">最近</text>
          <text class="t-last-text ellipsis">{{item.lastRecord}}</text>
        </view>

        <!-- 底部 -->
        <view class="t-foot row-between">
          <view class="row">
            <text class="fs-22 t-3">🕒 {{item.createTimeText}}</text>
            <text class="fs-22 t-3 ml-16">👤 {{item.handler}}</text>
          </view>
          <text class="fs-22 t-4">{{item.recordCount}} 条记录 ›</text>
        </view>
      </view>
    </block>

    <t-empty
      wx:else
      icon="🛠"
      text="{{activeTab === '全部' ? '暂无售后工单，一切正常' : '该状态下暂无工单'}}"
      action="＋ 新建工单"
      bind:action="openCreate"
    />
  </view>

  <view class="bottom-placeholder"></view>

  <!-- 新建入口 -->
  <view class="fab" bindtap="openCreate">＋</view>

  <!-- 新建工单弹窗 -->
  <t-popup
    visible="{{popupVisible}}"
    title="新建售后工单"
    confirmText="提交工单"
    bind:cancel="closeCreate"
    bind:confirm="doCreate"
  >
    <view class="popup-form">
      <view class="form-item">
        <text class="form-label form-label-req">所属项目</text>
        <picker
          class="flex-1"
          mode="selector"
          range="{{projectNames}}"
          value="{{projectIndex}}"
          bindchange="onProjectChange"
        >
          <view class="form-value ellipsis">
            {{projects.length > 0 ? projects[projectIndex].name : '暂无可选项目'}} ›
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label form-label-req">客户姓名</text>
        <input
          class="form-input"
          placeholder="请输入客户姓名"
          placeholder-class="form-placeholder"
          value="{{form.customerName}}"
          bindinput="onNameInput"
        />
      </view>

      <view class="form-item">
        <text class="form-label form-label-req">联系电话</text>
        <input
          class="form-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          placeholder-class="form-placeholder"
          value="{{form.phone}}"
          bindinput="onPhoneInput"
        />
      </view>

      <view class="form-item">
        <text class="form-label">售后类型</text>
        <picker
          class="flex-1"
          mode="selector"
          range="{{typeOptions}}"
          value="{{typeIndex}}"
          bindchange="onTypeChange"
        >
          <view class="form-value">{{typeOptions[typeIndex]}} ›</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">优先级</text>
        <picker
          class="flex-1"
          mode="selector"
          range="{{priorityOptions}}"
          value="{{priorityIndex}}"
          bindchange="onPriorityChange"
        >
          <view class="form-value">{{priorityOptions[priorityIndex]}} ›</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">上门地址</text>
        <input
          class="form-input"
          placeholder="请输入详细地址"
          placeholder-class="form-placeholder"
          value="{{form.address}}"
          bindinput="onAddressInput"
        />
      </view>

      <view class="pf-block">
        <text class="pf-label form-label-req">问题描述</text>
        <textarea
          class="pf-textarea"
          placeholder="请描述客户反馈的问题现象、发生时间等"
          placeholder-class="pf-ph"
          maxlength="300"
          value="{{form.desc}}"
          bindinput="onDescInput"
        />
      </view>
    </view>
  </t-popup>
</view>
