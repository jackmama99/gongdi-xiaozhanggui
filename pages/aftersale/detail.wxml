<view class="page" wx:if="{{ticket}}">
  <!-- 顶部工单头卡 -->
  <view class="head">
    <view class="row-between">
      <view class="row">
        <text class="head-no">{{ticket.no}}</text>
        <t-tag class="ml-8" text="{{ticket.priority}}" type="{{priorityColor}}" size="small" dot="{{true}}" />
      </view>
      <t-tag text="{{ticket.status}}" type="{{statusColor}}" />
    </view>

    <view class="head-type">{{ticket.type}}</view>

    <view class="head-meta row">
      <text class="head-chip">🕒 提交于 {{ticket.createTimeFull}}</text>
      <text class="head-chip">👤 {{ticket.handler}}</text>
    </view>

    <view class="head-grid">
      <view class="hg-item">
        <text class="hg-label">工单状态</text>
        <text class="hg-value">{{ticket.status}}</text>
      </view>
      <view class="hg-item">
        <text class="hg-label">处理记录</text>
        <text class="hg-value bold-num">{{ticket.recordCount}} 条</text>
      </view>
      <view class="hg-item">
        <text class="hg-label">优先级</text>
        <text class="hg-value">{{ticket.priority}}</text>
      </view>
    </view>
  </view>

  <view class="container">
    <!-- 客户信息 -->
    <t-section title="客户信息" />
    <view class="card">
      <view class="kv" bindtap="goProject">
        <text class="kv-k">所属项目</text>
        <text class="kv-v t-primary ellipsis">{{ticket.projectName}} ›</text>
      </view>
      <view class="kv">
        <text class="kv-k">客户姓名</text>
        <text class="kv-v">{{ticket.customerName}}</text>
      </view>
      <view class="kv" bindtap="onCall">
        <text class="kv-k">联系电话</text>
        <text class="kv-v t-primary">📞 {{ticket.phoneText}}</text>
      </view>
      <view class="kv kv-block">
        <text class="kv-k">上门地址</text>
        <text class="kv-v kv-multi">{{ticket.address}}</text>
      </view>
    </view>

    <!-- 问题描述 -->
    <t-section title="问题描述" sub="客户报修原文" />
    <view class="card">
      <view class="desc-box">{{ticket.desc}}</view>
      <view class="desc-foot row-between">
        <text class="fs-22 t-4">提交时间 {{ticket.createTimeText}}</text>
        <text class="fs-22 t-4">{{ticket.type}}</text>
      </view>
    </view>

    <!-- 处理时间轴 -->
    <t-section title="处理进度" sub="共 {{ticket.recordCount}} 条记录" />
    <view class="card">
      <block wx:if="{{hasRecords}}">
        <view wx:for="{{records}}" wx:key="id" class="tl-item">
          <view class="tl-axis">
            <view class="tl-dot {{item.isLast ? 'active' : ''}}"></view>
            <view wx:if="{{!item.isLast}}" class="tl-line"></view>
          </view>
          <view class="tl-body">
            <view class="row-between">
              <view class="row">
                <t-tag text="{{item.action}}" type="{{item.theme}}" size="small" />
                <text class="tl-operator">{{item.operator}}</text>
              </view>
              <text class="tl-time">{{item.timeText}}</text>
            </view>
            <text wx:if="{{item.content}}" class="tl-content">{{item.content}}</text>
          </view>
        </view>
      </block>
      <t-empty wx:else icon="🕘" text="暂无处理记录，受理后开始跟踪处理" />
    </view>

    <!-- 完结信息 -->
    <block wx:if="{{ticket.isDone}}">
      <t-section title="结单信息" />
      <view class="card">
        <view class="kv">
          <text class="kv-k">办理状态</text>
          <text class="kv-v t-success fw-500">{{ticket.status}}</text>
        </view>
        <view class="kv">
          <text class="kv-k">处理人</text>
          <text class="kv-v">{{ticket.handler}}</text>
        </view>
        <view class="kv">
          <text class="kv-k">完成时间</text>
          <text class="kv-v">{{ticket.resolveTimeText ? ticket.resolveTimeText : '—'}}</text>
        </view>
        <view class="kv">
          <text class="kv-k">处理用时</text>
          <text class="kv-v">共 {{ticket.recordCount}} 条处理记录</text>
        </view>
      </view>
    </block>
  </view>

  <view class="bottom-placeholder"></view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="btn btn-plain flex-1" bindtap="onCall">📞 联系客户</view>

    <block wx:if="{{ticket.isPending}}">
      <view class="btn btn-primary flex-1" bindtap="onAccept">受理工单</view>
    </block>

    <block wx:elif="{{ticket.isDoing}}">
      <view class="btn btn-ghost flex-1" bindtap="openRecordPopup">＋ 处理记录</view>
      <view class="btn btn-success flex-1" bindtap="onFinish">标记完成</view>
    </block>

    <block wx:else>
      <view class="btn btn-plain flex-1 btn-disabled">{{ticket.doneBtnText}}</view>
    </block>
  </view>

  <!-- 添加处理记录弹窗 -->
  <t-popup
    visible="{{popupVisible}}"
    title="添加处理记录"
    confirmText="保存"
    bind:cancel="closeRecordPopup"
    bind:confirm="doAddRecord"
  >
    <view class="popup-form">
      <view class="pf-block">
        <text class="pf-label">处理动作</text>
        <view class="chips">
          <view
            wx:for="{{actions}}"
            wx:key="*this"
            class="chip {{actionIndex === index ? 'active' : ''}}"
            data-index="{{index}}"
            bindtap="onActionTap"
          >
            {{item}}
          </view>
        </view>
      </view>

      <view class="pf-block">
        <text class="pf-label">处理内容</text>
        <textarea
          class="pf-textarea"
          placeholder="记录上门情况、处理措施、客户反馈…"
          placeholder-class="pf-ph"
          maxlength="300"
          value="{{recordContent}}"
          bindinput="onContentInput"
        />
      </view>
    </view>
  </t-popup>
</view>

<view wx:else class="loading">加载中…</view>
