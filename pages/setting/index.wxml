<view class="page">
  <!-- 公司信息 -->
  <view class="container">
    <view class="group-title mt-24">企业信息</view>
    <view class="card">
      <view class="company-head">
        <view class="company-logo">🏢</view>
        <view class="flex-1">
          <view class="company-name">{{company.name}}</view>
          <view class="company-tag">{{company.tag || '未填写业务类型'}}</view>
        </view>
      </view>
      <view class="divider"></view>
      <view class="info-row" bindtap="copyAddress">
        <text class="info-label">公司地址</text>
        <text class="info-value">{{company.address}}</text>
      </view>
      <view class="info-row" bindtap="callCompany">
        <text class="info-label">联系电话</text>
        <text class="info-value t-primary">{{company.phone}}</text>
      </view>
    </view>

    <!-- 当前账号 -->
    <view class="group-title mt-32">当前账号</view>
    <view class="card">
      <view class="info-row" bindtap="showAccount">
        <text class="info-label">姓名</text>
        <text class="info-value">{{user.name}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">角色</text>
        <text class="info-value">{{user.role}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">部门</text>
        <text class="info-value">{{user.dept}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">手机号</text>
        <text class="info-value">{{user.phone}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">登录账号</text>
        <text class="info-value">{{user.account}}</text>
      </view>
      <view class="info-row" bindtap="openPwdPopup">
        <text class="info-label">登录密码</text>
        <text class="info-value t-primary">修改 ›</text>
      </view>
    </view>

    <!-- 团队成员 -->
    <view class="group-title mt-32">团队成员</view>
    <view class="card">
      <view wx:for="{{users}}" wx:key="id" class="member-row">
        <view class="member-avatar">{{item.name}}</view>
        <view class="flex-1">
          <view class="member-name">{{item.name}}</view>
          <view class="member-dept">{{item.dept}}</view>
        </view>
        <view class="role-tag">{{item.role}}</view>
      </view>
    </view>

    <!-- 数据概览 -->
    <view class="group-title mt-32">数据概览</view>
    <view class="card db-grid">
      <view wx:for="{{dbStats}}" wx:key="key" class="db-item">
        <view class="db-num bold-num">{{item.count}}</view>
        <view class="db-name">{{item.name}}</view>
      </view>
    </view>

    <!-- 其他 -->
    <view class="group-title mt-32">其他</view>
    <view class="card">
      <view class="info-row" bindtap="showAbout">
        <text class="info-label">关于工地小掌柜</text>
        <text class="info-value">v{{appInfo.version}}{{isDemo ? ' · 演示版' : ''}}</text>
      </view>
      <view wx:if="{{isDemo}}" class="info-row">
        <text class="info-label">技术架构</text>
        <text class="info-value">{{appInfo.tech}}</text>
      </view>
      <view wx:if="{{isDemo}}" class="info-row">
        <text class="info-label">数据模式</text>
        <text class="info-value">{{appInfo.dataMode}}</text>
      </view>
    </view>

    <view class="card mt-24">
      <view class="info-row" bindtap="goService">
        <text class="info-label">用户服务协议</text>
        <text class="info-value form-arrow">查看 ›</text>
      </view>
      <view class="info-row" bindtap="goPrivacy">
        <text class="info-label">隐私政策</text>
        <text class="info-value form-arrow">查看 ›</text>
      </view>
      <view class="info-row" bindtap="showAudit">
        <text class="info-label">操作记录</text>
        <text class="info-value form-arrow">最近 20 条 ›</text>
      </view>
      <view class="info-row" bindtap="exportBackup">
        <text class="info-label">导出数据备份</text>
        <text class="info-value form-arrow">复制 JSON ›</text>
      </view>
    </view>

    <view wx:if="{{isDemo}}" class="reset-btn" bindtap="doReset">重置演示数据</view>
    <view class="logout-btn" bindtap="doLogout">退出登录</view>
    <view class="bottom-space"></view>
  </view>

  <!-- 修改密码弹窗 -->
  <view wx:if="{{pwdVisible}}" class="pwd-mask" bindtap="closePwd">
    <view class="pwd-box" catchtap="noop">
      <view class="pwd-title">修改登录密码</view>
      <input class="pwd-input" password placeholder="原密码（首次登录为 123456）" value="{{oldPwd}}" bindinput="onOldPwd" />
      <input class="pwd-input" password placeholder="新密码（至少 6 位）" value="{{newPwd}}" bindinput="onNewPwd" />
      <input class="pwd-input" password placeholder="再输入一次新密码" value="{{newPwd2}}" bindinput="onNewPwd2" />
      <view wx:if="{{pwdError}}" class="pwd-error">{{pwdError}}</view>
      <view class="pwd-actions">
        <view class="pwd-btn" bindtap="closePwd">取消</view>
        <view class="pwd-btn pwd-btn-primary" bindtap="submitPwd">确认修改</view>
      </view>
    </view>
  </view>
</view>
