/* 顶部信息卡 */
.hero {
  position: relative;
  overflow: hidden;
  padding-bottom: 24rpx;
}

.hero-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 320rpx;
  background: var(--primary);
}

.hero-body {
  position: relative;
  padding: 30rpx 28rpx 28rpx;
}

.hero-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.hero-no {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  margin-top: 8rpx;
}

.hero-addr {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 22rpx;
  line-height: 1.5;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.hero-tag {
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.hero-time {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  margin-top: 24rpx;
}

.ht-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.ht-k {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
}

.ht-v {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

.ht-line {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.25);
}

/* 进度 */
.progress-big {
  font-size: 44rpx;
  color: var(--primary);
}

.progress-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.overdue-tip {
  margin-top: 18rpx;
  background: var(--danger-light);
  color: var(--danger);
  font-size: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}

/* 财务 */
.fin-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.fin-cell {
  width: 50%;
  padding: 18rpx 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.fin-k {
  font-size: 22rpx;
  color: var(--text-3);
}

.fin-v {
  font-size: 32rpx;
  color: var(--text-1);
}

.fin-bar-wrap {
  margin-top: 12rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  gap: 32rpx;
}

.fin-bar-item {
  flex: 1;
}

.fin-bar-label {
  font-size: 22rpx;
  color: var(--text-3);
}

.fin-bar-num {
  font-size: 22rpx;
  color: var(--text-2);
  font-weight: 600;
}

.fin-remain {
  margin-top: 22rpx;
  background: var(--fill);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

/* 入口九宫格 */
.entry-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 20rpx;
  padding: 10rpx 0;
  box-shadow: var(--shadow);
}

.entry-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.entry-hover {
  background: var(--fill);
}

.entry-icon {
  width: 78rpx;
  height: 78rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-bottom: 12rpx;
}

.entry-name {
  font-size: 24rpx;
  color: var(--text-2);
}

/* 节点 */
.node-card {
  padding: 24rpx 28rpx 8rpx;
}

.node-line {
  display: flex;
  gap: 20rpx;
}

.node-dot-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  flex-shrink: 0;
}

.node-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.node-dot.dot-green {
  background: var(--success);
}

.node-dot.dot-blue {
  background: var(--primary);
}

.node-dot.dot-orange {
  background: var(--warning);
}

.node-dot.dot-red {
  background: var(--danger);
}

.node-dot.dot-gray {
  background: var(--line);
}

.node-check {
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
}

.node-connector {
  flex: 1;
  width: 3rpx;
  background: var(--line);
  margin: 8rpx 0;
  min-height: 40rpx;
}

.node-body {
  flex: 1;
  padding-bottom: 30rpx;
  min-width: 0;
}

.node-name {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}

.node-time {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 8rpx;
}

.node-all {
  text-align: center;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: var(--primary);
  border-top: 1rpx solid var(--line);
  margin: 0 -28rpx;
}

/* 变更 */
.change-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.change-item:last-child {
  border-bottom: none;
}

.change-title {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 500;
  max-width: 300rpx;
}

.change-meta {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 8rpx;
}

.change-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.change-amount {
  font-size: 28rpx;
  color: var(--danger);
}

.change-btn {
  font-size: 22rpx;
  color: #fff;
  background: var(--primary);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* 巡检 */
.insp-card {
  margin-bottom: 16rpx;
}

.insp-type {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
}

.insp-meta {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 12rpx;
}

/* 团队 */
.team-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.team-row:last-child {
  border-bottom: none;
}

.team-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 32rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.team-name {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}

.team-role {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.team-tag {
  font-size: 20rpx;
  color: var(--text-3);
  background: var(--bg);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

/* 客户条 */
.customer-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-top: 20rpx;
  box-shadow: var(--shadow);
}

.cust-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.cust-icon {
  font-size: 32rpx;
}

.cust-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.cust-sub {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

.cust-call {
  font-size: 32rpx;
  padding: 8rpx 16rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
}


/* 新增变更弹窗 */
.chg-mask {
  position: fixed; inset: 0; z-index: 210;
  background: rgba(22, 33, 29, 0.45);
  display: flex; align-items: center; justify-content: center;
  padding: 0 60rpx;
}
.chg-box { width: 100%; background: #fff; border-radius: 32rpx; padding: 36rpx 32rpx 28rpx; }
.chg-title { font-size: 30rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; color: var(--text-1); }
.chg-input {
  height: 84rpx; line-height: 84rpx; background: var(--fill);
  border-radius: 16rpx; padding: 0 24rpx; margin-bottom: 16rpx;
  font-size: 28rpx; box-sizing: border-box; color: var(--text-1);
}
.chg-actions { display: flex; gap: 20rpx; margin-top: 8rpx; }
.chg-btn {
  flex: 1; min-height: 84rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 18rpx; background: var(--fill); color: var(--text-2); font-size: 28rpx;
}
.chg-btn-primary { background: var(--primary); color: #fff; }
