/* 顶部 */
.head {
  background: var(--primary);
  padding: 32rpx 28rpx 36rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.head-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.head-meta {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 10rpx;
}

.head-progress {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 30rpx;
}

.hp-left {
  display: flex;
  align-items: baseline;
}

.hp-num {
  font-size: 64rpx;
  color: #fff;
  line-height: 1;
}

.hp-unit {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 4rpx;
}

.hp-right {
  flex: 1;
}

.hp-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.hp-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
}

.hp-track {
  margin-top: 22rpx;
  background: rgba(255, 255, 255, 0.24);
}

.hp-track .progress-fill {
  background: #fff;
}

/* 时间轴 */
.timeline {
  padding-top: 32rpx;
}

.tl-item {
  display: flex;
  gap: 0;
}

.tl-axis {
  width: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.tl-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
  flex-shrink: 0;
}

.tl-dot.dot-green {
  background: var(--success);
}

.tl-dot.dot-blue {
  background: var(--primary);
  box-shadow: 0 0 0 6rpx rgba(59, 110, 246, 0.18);
}

.tl-dot.dot-orange {
  background: var(--warning);
}

.tl-dot.dot-red {
  background: var(--danger);
}

.tl-dot.dot-gray {
  background: var(--line);
}

.tl-check {
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
}

.tl-pulse {
  width: 14rpx;
  height: 14rpx;
  border-radius: 8rpx;
  background: #fff;
}

.tl-line {
  flex: 1;
  width: 3rpx;
  background: var(--line);
  margin: 8rpx 0;
  min-height: 30rpx;
}

.tl-content {
  flex: 1;
  padding-bottom: 20rpx;
  min-width: 0;
}

.tl-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(27, 34, 51, 0.05);
  border: 1rpx solid var(--line);
}

.tl-running {
  border: 2rpx solid var(--primary);
  box-shadow: 0 6rpx 22rpx rgba(59, 110, 246, 0.15);
}

.tl-seq {
  font-size: 20rpx;
  color: var(--text-3);
  background: var(--bg);
  width: 34rpx;
  height: 34rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 34rpx;
  flex-shrink: 0;
}

.tl-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.tl-cat {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 8rpx;
  padding-left: 46rpx;
}

.tl-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.tl-arrow {
  font-size: 22rpx;
  color: var(--text-4);
}

.tl-dates {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-left: 46rpx;
}

.tl-date {
  font-size: 22rpx;
  color: var(--text-3);
}

.tl-overdue {
  font-size: 22rpx;
  color: var(--danger);
  font-weight: 500;
}

/* 展开详情 */
.tl-detail {
  margin-top: 4rpx;
}

.tl-divider {
  height: 1rpx;
  background: var(--line);
  margin: 18rpx 0;
}

.tl-info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 10rpx 0;
  gap: 20rpx;
}

.tl-info-k {
  font-size: 24rpx;
  color: var(--text-3);
  flex-shrink: 0;
}

.tl-info-v {
  font-size: 24rpx;
  color: var(--text-1);
  text-align: right;
  flex: 1;
}

.tl-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.done-mark {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--success);
  background: var(--success-light);
  border-radius: 28rpx;
  padding: 12rpx 0;
}

/* 提示 */
.tip-card {
  margin-top: 20rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 22rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.bottom-space {
  height: 60rpx;
}
