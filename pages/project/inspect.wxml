<view class="page">
  <view class="head">
    <view class="head-name">{{project.name}}</view>
    <view class="head-sub">施工巡检与验收记录 · 共 {{list.length}} 条</view>
  </view>

  <view class="container">
    <block wx:if="{{list.length > 0}}">
      <view wx:for="{{list}}" wx:key="id" class="card insp-card">
        <view data-id="{{item.id}}" bindtap="toggleExpand">
          <view class="row-between">
            <view class="row gap-12">
              <text class="insp-type">{{item.type}}</text>
              <t-tag text="{{item.result}}" type="{{item.resultColor}}" size="small"></t-tag>
            </view>
            <text class="insp-expand">{{item.expanded ? '收起 ⌃' : '展开 ⌄'}}</text>
          </view>

          <view class="insp-meta">
            <text>{{item.date}}</text>
            <text class="insp-dot">·</text>
            <text>{{item.inspector}}</text>
            <text class="insp-dot">·</text>
            <text class="{{item.passCount === item.totalCount ? 't-success' : 't-warning'}}">
              检查项 {{item.passCount}}/{{item.totalCount}} 合格
            </text>
          </view>
        </view>

        <!-- 展开检查项明细 -->
        <view wx:if="{{item.expanded}}" class="insp-detail">
          <view class="insp-divider"></view>
          <view wx:for="{{item.items}}" wx:key="name" wx:for-item="sub" class="check-row">
            <view class="check-icon {{sub.pass ? 'check-pass' : 'check-fail'}}">
              {{sub.pass ? '✓' : '✕'}}
            </view>
            <view class="flex-1">
              <view class="check-name">{{sub.name}}</view>
              <view wx:if="{{sub.note}}" class="check-note">{{sub.note}}</view>
            </view>
          </view>
          <view wx:if="{{item.remark}}" class="insp-remark">
            📝 {{item.remark}}
          </view>

          <!-- 现场照片 -->
          <view wx:if="{{item.hasImages}}" class="insp-photos">
            <image
              wx:for="{{item.images}}"
              wx:key="*this"
              wx:for-item="img"
              class="insp-photo"
              src="{{img}}"
              mode="aspectFill"
              data-id="{{item.id}}"
              bindtap="onPreviewSaved"
            />
          </view>
        </view>
      </view>
    </block>

    <view wx:else class="card">
      <t-empty icon="✅" text="暂无巡检记录，点击下方按钮新增"></t-empty>
    </view>

    <view class="bottom-placeholder"></view>
  </view>

  <view class="bottom-bar">
    <view class="btn btn-primary btn-block" bindtap="openPopup">+ 新增巡检记录</view>
  </view>

  <!-- 新增巡检弹窗 -->
  <t-popup
    visible="{{showPopup}}"
    title="新增巡检记录"
    cancelText="取消"
    confirmText="提交"
    maxHeight="82vh"
    bind:cancel="closePopup"
    bind:confirm="submit"
  >
    <view class="form-body">
      <!-- 巡检类型 -->
      <view class="form-item">
        <text class="form-label form-label-req">巡检类型</text>
        <picker mode="selector" range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onTypeChange">
          <view class="form-value form-arrow">{{form.type}}</view>
        </picker>
      </view>

      <!-- 验收结果 -->
      <view class="form-item">
        <text class="form-label form-label-req">验收结果</text>
        <picker mode="selector" range="{{resultOptions}}" value="{{resultIndex}}" bindchange="onResultChange">
          <view class="form-value form-arrow">{{form.result}}</view>
        </picker>
      </view>

      <!-- 检查项 -->
      <view class="form-block-title">检查项（点击切换合格状态）</view>
      <view wx:for="{{form.items}}" wx:key="name" class="check-item">
        <view class="row-between" data-index="{{index}}" bindtap="toggleItem">
          <text class="check-item-name">{{item.name}}</text>
          <view class="check-switch {{item.pass ? 'on' : 'off'}}">
            {{item.pass ? '合格' : '不合格'}}
          </view>
        </view>
        <input
          class="check-item-input"
          placeholder="补充说明（选填）"
          placeholder-class="check-ph"
          value="{{item.note}}"
          data-index="{{index}}"
          bindinput="onItemNote"
        />
      </view>

      <!-- 备注 -->
      <view class="form-block-title">巡检结论</view>
      <textarea
        class="form-textarea"
        placeholder="请填写整体结论或整改要求"
        placeholder-class="check-ph"
        value="{{form.remark}}"
        bindinput="onRemark"
        maxlength="300"
      ></textarea>

      <!-- 现场照片 -->
      <view class="form-block-title">现场照片（选填，最多 9 张）</view>
      <view class="photo-grid">
        <view wx:for="{{form.images}}" wx:key="*this" class="photo-cell">
          <image
            class="photo-img"
            src="{{item}}"
            mode="aspectFill"
            data-index="{{index}}"
            bindtap="onPreviewImage"
          />
          <view class="photo-del" data-index="{{index}}" catchtap="onDeleteImage">✕</view>
        </view>
        <view wx:if="{{form.images.length < 9}}" class="photo-add" bindtap="onChooseImage">
          <text class="photo-add-icon">＋</text>
          <text class="photo-add-text">拍照</text>
        </view>
      </view>
    </view>
  </t-popup>
</view>
