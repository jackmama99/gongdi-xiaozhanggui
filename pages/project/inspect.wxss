.head {
  background: var(--primary);
  padding: 32rpx 28rpx 40rpx;
  border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 24rpx;
}

.head-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.head-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 10rpx;
}

/* 巡检卡片 */
.insp-card {
  margin-bottom: 20rpx;
}

.insp-type {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.insp-expand {
  font-size: 22rpx;
  color: var(--primary);
  flex-shrink: 0;
}

.insp-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-3);
  gap: 8rpx;
}

.insp-dot {
  color: var(--text-4);
}

/* 展开明细 */
.insp-detail {
  margin-top: 6rpx;
}

.insp-divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0 16rpx;
}

.check-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 12rpx 0;
}

.check-icon {
  width: 34rpx;
  height: 34rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.check-pass {
  background: var(--success-light);
  color: var(--success);
}

.check-fail {
  background: var(--danger-light);
  color: var(--danger);
}

.check-name {
  font-size: 26rpx;
  color: var(--text-1);
}

.check-note {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
  line-height: 1.5;
}

.insp-remark {
  margin-top: 16rpx;
  background: var(--fill);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
}

/* 弹窗表单 */
.form-body {
  padding: 0 32rpx 20rpx;
}

.form-block-title {
  font-size: 26rpx;
  color: var(--text-3);
  margin: 28rpx 0 16rpx;
}

.check-item {
  background: var(--fill);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
}

.check-item-name {
  font-size: 26rpx;
  color: var(--text-1);
}

.check-switch {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.check-switch.on {
  background: var(--success-light);
  color: var(--success);
}

.check-switch.off {
  background: var(--danger-light);
  color: var(--danger);
}

.check-item-input {
  margin-top: 14rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  box-sizing: border-box;
}

.check-ph {
  color: var(--text-4);
  font-size: 22rpx;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: var(--fill);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

/* ---------------- 现场照片 ---------------- */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 12rpx;
}

.photo-cell {
  position: relative;
  width: 156rpx;
  height: 156rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
  background: var(--fill);
}

.photo-del {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
}

.photo-add {
  width: 156rpx;
  height: 156rpx;
  border-radius: 12rpx;
  border: 2rpx dashed var(--line);
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-add-icon {
  font-size: 40rpx;
  color: var(--text-4);
  line-height: 1;
}

.photo-add-text {
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

.insp-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.insp-photo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: var(--fill);
}
