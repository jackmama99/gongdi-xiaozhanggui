.wb-page {
  padding-bottom: 20rpx;
}

/* ---------------- 头部（浅底） ---------------- */
.wb-head {
  padding: 28rpx 28rpx 8rpx;
}

.head-date {
  font-size: 22rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
}

.greet {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-1);
  line-height: 1.3;
  margin-top: 8rpx;
}

.head-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 10rpx;
}

.head-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* ---------------- 经营概览（绿卡） ---------------- */
.summary {
  display: flex;
  flex-wrap: wrap;
  background: var(--primary);
  border-radius: 40rpx;
  padding: 28rpx 8rpx;
  margin-top: 20rpx;
}

.summary-cell {
  width: 50%;
  padding: 14rpx 26rpx;
  box-sizing: border-box;
}

.summary-cell:nth-child(odd) {
  border-right: 1rpx solid rgba(255, 255, 255, 0.18);
}

.summary-cell:nth-child(-n + 2) {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.18);
  padding-bottom: 24rpx;
}

.summary-cell:nth-child(n + 3) {
  padding-top: 24rpx;
}

.summary-value {
  display: flex;
  align-items: baseline;
  color: #fff;
}

.summary-value .bold-num {
  font-size: 44rpx;
  line-height: 1.2;
  letter-spacing: -0.5rpx;
}

.summary-suffix {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-left: 6rpx;
}

.summary-label {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
}

.summary-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 4rpx;
}

/* ---------------- 风险提醒 ---------------- */
.alert-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.alert-item {
  display: flex;
  align-items: center;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  gap: 16rpx;
}

.alert-danger {
  background: var(--danger-light);
}

.alert-warning {
  background: var(--warning-light);
}

.alert-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.alert-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-1);
}

.alert-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

/* ---------------- 待办卡片 ---------------- */
.todo-card {
  padding: 0 28rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
  gap: 16rpx;
}

.todo-item:last-of-type {
  border-bottom: none;
}

.todo-left {
  flex-shrink: 0;
}

.todo-title {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}

.todo-meta {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  display: flex;
  align-items: center;
}

.todo-type {
  color: var(--primary);
}

.todo-dot {
  margin: 0 8rpx;
}

.todo-time {
  font-size: 20rpx;
  color: var(--text-4);
  flex-shrink: 0;
}

.todo-more {
  text-align: center;
  padding: 22rpx 0;
  font-size: 24rpx;
  color: var(--text-3);
  border-top: 1rpx solid var(--line);
}

.todo-arrow {
  font-size: 28rpx;
  margin-left: 4rpx;
}

/* ---------------- 今日施工 ---------------- */
.today-task-card {
  padding: 0 28rpx;
}

.today-task-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.today-task-item:last-child {
  border-bottom: none;
}

.today-task-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
  flex-shrink: 0;
}

.today-task-dot-danger {
  background: var(--danger);
}

.today-task-title {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}

.today-task-meta {
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 22rpx;
}

.today-empty-card {
  padding: 20rpx 0;
}

/* ---------------- 快捷入口 ---------------- */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx 0;
  box-shadow: var(--shadow);
}

.quick-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  box-sizing: border-box;
}

.quick-item-hover {
  background: var(--fill);
}

.quick-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-bottom: 12rpx;
}

.quick-name {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 500;
}

.quick-desc {
  font-size: 20rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

/* ---------------- 项目卡片 ---------------- */
.project-card {
  margin-bottom: 20rpx;
}

.project-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.project-addr {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.project-stage {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  background: var(--fill);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  gap: 12rpx;
}

.stage-label {
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
}

.stage-value {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  flex: 1;
}

.stage-progress {
  font-size: 22rpx;
  color: var(--text-4);
  flex-shrink: 0;
}

.project-foot {
  display: flex;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.foot-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.foot-label {
  font-size: 22rpx;
  color: var(--text-4);
}

.foot-value {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}

.bottom-space {
  height: 20rpx;
}
