/* 材料采购列表 */

.page {
  padding-bottom: 40rpx;
}

/* 项目范围提示 */
.scope-bar {
  display: flex;
  align-items: center;
  background: var(--primary-light);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}

.scope-emoji {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.scope-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.scope-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  flex: 1;
  min-width: 0;
}

/* 统计 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.stat-box {
  width: calc((100% - 20rpx) / 2);
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  box-shadow: var(--shadow);
}

.stat-box-label {
  font-size: 22rpx;
  color: var(--text-3);
}

.stat-box-value {
  font-size: 38rpx;
  color: var(--text-1);
  margin-top: 8rpx;
  line-height: 1.2;
}

.stat-box-value-main {
  color: var(--primary);
}

.stat-box-unit {
  font-size: 22rpx;
  color: var(--text-3);
  margin-left: 6rpx;
  font-weight: 400;
}

/* 材料卡片 */
.mat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--line);
}

.mat-card + .mat-card {
  margin-top: 20rpx;
}

.mat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  max-width: 400rpx;
}

.mat-spec {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 10rpx;
}

.mat-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  gap: 16rpx;
}

.mat-project {
  font-size: 22rpx;
  color: var(--text-2);
  flex: 1;
  min-width: 0;
}

.mat-no {
  font-size: 20rpx;
  color: var(--text-4);
  flex-shrink: 0;
}

.mat-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--line);
}

.mat-qty {
  display: flex;
  align-items: baseline;
}

.mat-qty-num {
  font-size: 32rpx;
  color: var(--text-1);
}

.mat-qty-unit {
  font-size: 22rpx;
  color: var(--text-3);
  margin-left: 4rpx;
}

.mat-price {
  font-size: 22rpx;
  color: var(--text-3);
  margin-left: 12rpx;
}

.mat-amount {
  font-size: 32rpx;
  color: var(--primary);
}

.mat-supplier {
  font-size: 20rpx;
  color: var(--text-4);
  margin-top: 10rpx;
}

/* 弹窗表单 */
.popup-form {
  padding: 0 32rpx 20rpx;
}

.unit-suggest {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 16rpx 0 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.unit-chip {
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  background: var(--bg);
  color: var(--text-2);
  font-size: 24rpx;
}

.unit-chip-active {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 500;
}
